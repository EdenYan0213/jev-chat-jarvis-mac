# jev-jarvis 配置示例
# 变量名都是通用约定。推荐放 ~/.config/jev-jarvis/env（仓库之外，不可能被提交）；
# 放这里（项目根目录 .env）也可以，已在 .gitignore 中排除。

# ── 判断层：TypeSafe Jev（无嘴模型，只输出意图/风险，不写文本）────────────
# 填了就用官方 Jev；不填则用本地开源复刻 decider-2b（首次运行下载约 7GB）
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# 也可让判断和生成共用一个 OpenAI 兼容本地模型，避免同时常驻两套权重。
#JEV_JUDGE_BACKEND=openai
#JEV_JUDGE_API_KEY=ollama
#JEV_JUDGE_BASE_URL=http://127.0.0.1:11434/v1
#JEV_JUDGE_MODEL=qwen3.5:4b

# ── 生成层：写回复候选（Jev 写不了文本，这层必须另配）──────────────────
# 任意 OpenAI 兼容端点
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# 不需要候选回复时设为 0；意图/风险/情绪判断和本地 Session 保存仍继续
#JEV_GENERATION_ENABLED=0

# reasoning_effort 避免思考耗尽输出预算；本应用会单独维护本地 Ollama 的驻留时间。
#OPENAI_EXTRA_BODY='{"reasoning_effort":"none"}'

# 如果服务商是 Anthropic 兼容格式，改用这一组（OPENAI_* 有 key 时优先）
#ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
#ANTHROPIC_MODEL=glm-4-flash

# 通用模型名兜底（两家共用）
#LLM_MODEL=

# ── 可选：自定义「话术」（面板下拉框里会多出来）──────────────────────────
# 用 | 分隔多条，每条「名字=说明」；同名的会覆盖内置话术。
# 说明是直接喂给模型的指令，写清「什么语气 + 别变成什么」比只写形容词管用。
# export JEV_TONES="摸鱼大师=像资深摸鱼选手，把活推得漂亮又不失礼|孙子兵法=用兵法比喻说话"

# ── 可选：启动时打开「YOLO 检测框」────────────────────────────────────
# 把每次 OCR 认出的消息用彩框实时框在微信窗口上（对方/我分色+真实置信度，
# 被判断那条带意图·风险标签）。点击穿透、不进抓图。菜单栏 J 图标随时开关。
#JEV_BOXES=1
